## FRONTEND SIGNATURE MAP — frontend/src/utils/

### units.ts
  UNIT_CONVERSIONS: Record<UnitKey, number>  # same values as backend
  convertToGrams(amount: number, unit: UnitKey) → number

### nutrition.ts
  FDA_DAILY_VALUES: Partial<Record<keyof MacroProfile, number>>
  NUTRIENT_FIELDS: (keyof MacroProfile)[]
  roundHalfUp(x: number, ndigits=0) → number  # internal; uses Number.EPSILON to fix FP drift
  round1(n: number) → number  # roundHalfUp(n, 1); exported for display use
  calculateRecipeMacros(ingredients: IngredientItem[], portionDivisor: number) → MacroProfile
    # Uses ingredient.baseMacros (cached from API); same math as backend; throws RangeError if divisor out of [1,999]
  getHighlightKeys(baseMacros: MacroProfile) → HighlightSet
    # Returns Set of top 2 nutrient keys by %DV contribution; used for hover-highlight sync
  computeDailyValues(profile: MacroProfile) → Partial<Record<keyof MacroProfile, number>>
    # {nutrient: roundHalfUp((val/DV)*100)} only for nutrients with DV
  formatDV(nutrient: keyof MacroProfile, profile: MacroProfile) → string
    # "—" if no DV | "<1%" if rounds to 0 but val>0 | "{n}%"
  buildIngredientsString(ingredients: IngredientItem[]) → string
    # Sorted by gram weight desc, ALL CAPS, period-terminated; "" if empty

