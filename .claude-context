  # Returns (unrounded_per_serving_dict, rounded_MacroProfile)

compute_daily_value_pct(value: float, nutrient: str) -> int | None
  # None if nutrient has no DV; else int(round_half_up((value / DV) * 100))
  # Caller renders "<1%" when result == 0 but value > 0
