## BACKEND SIGNATURE MAP — backend/app/

### config.py
  Settings.db_path: str = "data/nutrition.db"
  Settings.cors_origins: list[str] = ["http://localhost:5173", "http://localhost:80"]
  settings = Settings()

### models.py
  IngredientItem(fdc_id: int, name: str[1..120], amount: float>0, unit: UnitKey)
  GenerateLabelRequest(portion_divisor: int[1-999]=8, label_name: str[..120]="",
                       width_inches: float(0.1-12]=2.75, height_inches: float(0-20]|None,
                       ingredients: list[IngredientItem][1..100])
  MacroProfile(calories, fat_total_g, fat_saturated_g, cholesterol_mg, sodium_mg,
               carbohydrates_total_g, fiber_g, sugar_g, protein_g,
               vitamin_d_mcg, calcium_mg, iron_mg, potassium_mg)  # all float
  FoodSearchResult(fdc_id: int, name: str)
  PortionSize(amount: float, modifier: str, gram_weight: float)
  FoodDetail(fdc_id: int, name: str, macros: MacroProfile, portions: list[PortionSize])

### database.py
  get_connection(db_path=None) → sqlite3.Connection  # row_factory=Row, mode=ro, nolock=1
  search_foods(query: str, limit=80, db_path=None) → list[Row]  # LOWER LIKE LOWER
  get_food_by_id(fdc_id: int, db_path=None) → Row | None
  get_portions_by_id(fdc_id: int, db_path=None) → list[Row]
  get_foods_by_ids(fdc_ids: list[int], db_path=None) → list[Row]

  DB SCHEMA:
    food_macros(fdc_id PK, description, calories, fat_total_g, fat_saturated_g,
                cholesterol_mg, sodium_mg, carbohydrates_total_g, fiber_g, sugar_g,
                protein_g, vitamin_d_mcg, calcium_mg, iron_mg, potassium_mg)
    food_portions(id PK, fdc_id FK, amount, modifier, gram_weight)

### nutrition.py
  round_half_up(x: float, ndigits: int=0) → float  # Decimal ROUND_HALF_UP; matches JS Math.round

  calculate_recipe_macros(ingredients: list[IngredientItem],
                           food_rows: list,
                           portion_divisor: int) → tuple[dict[str, float], MacroProfile]
    # Returns (unrounded_per_serving, rounded_MacroProfile)
    # grams = amount * UNIT_CONVERSIONS[unit]; total[f] += db_row[f] * (grams/100)
    # per_serving = total[f] / portion_divisor; round calories→int, others→1dp
    # raises ValueError if portion_divisor ≤ 0 or fdc_id missing from food_rows

  compute_daily_value_pct(value: float, nutrient: str) → int | None
    # None if no DV; else int(round_half_up((value/DV)*100))
    # Caller should show "<1%" when result=0 but value>0

### search.py
  ranked_search(query: str, food_rows: list) → list[{"fdc_id": int, "name": str}]
    # Returns [] if len(query)<2; prefix matches first (alpha), contains next (alpha); top 40

### pdf.py
  _no_external_fetch(url: str) → bytes  # raises ValueError; prevents SSRF/file disclosure
  render_label_html(macros: MacroProfile, request: GenerateLabelRequest,
                    unrounded_macros: dict[str, float] | None = None) → str
    # unrounded_macros used for %DV calc (falls back to rounded if None)
    # Jinja2 fills label.html; ingredients sorted by gram weight desc, ALL CAPS
  generate_pdf(html: str) → bytes
    # HTML(string=html, url_fetcher=_no_external_fetch).write_pdf()

### main.py — Routes
  GET  /api/search?query=        → list[FoodSearchResult]  ([] if query<2 chars)
  GET  /api/food/{fdc_id}        → FoodDetail              (404 if missing)
  POST /api/generate_label       → PDF bytes Response      (400 bad request | 429 rate limit)
    @limiter.limit("10/minute")  Content-Disposition: attachment; filename="nutrition_label.pdf"

