# Frontend build-time configuration.
# Copy to .env.local for local dev, or set in your CI/host env for prod builds.
# Vite inlines VITE_* values into the JS bundle at build time.

# Buy Me a Coffee (or Ko-fi, GitHub Sponsors, etc.) profile URL.
# Leave unset to hide the Donate button entirely.
VITE_DONATE_URL=https://buymeacoffee.com/

# Optional: change the button label. Defaults to "DONATE".
# VITE_DONATE_LABEL=BUY ME A COFFEE
