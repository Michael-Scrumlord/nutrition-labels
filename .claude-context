### `nutrition.py`
```python
round_half_up(x: float, ndigits: int = 0) -> float
  # float(Decimal(x).quantize(Decimal(10)**-ndigits, ROUND_HALF_UP))

calculate_recipe_macros(
    ingredients: list[IngredientItem],
    food_rows: list,         # sqlite3.Row (or dict) from get_foods_by_ids()
    portion_divisor: int,
) -> tuple[dict[str, float], MacroProfile]
  # Per ingredient:  grams = amount * UNIT_CONVERSIONS[unit]
  #                  total[f] += (food[f] or 0.0) * (grams / 100)
  # Per serving:     val = total[f] / portion_divisor
  # Rounding:        calories -> round_half_up(val,0); others -> round_half_up(val,1)
  # Raises ValueError on portion_divisor <= 0 or fdc_id missing from food_rows
  # Returns (unrounded_per_serving_dict, rounded_MacroProfile)

compute_daily_value_pct(value: float, nutrient: str) -> int | None
  # None if nutrient has no DV; else int(round_half_up((value / DV) * 100))
  # Caller renders "<1%" when result == 0 but value > 0
```

