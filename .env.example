# Root .env — consumed by docker-compose.
# Copy to .env on the host; never commit the populated file.

# Public domain Caddy will issue a cert for. Required for production TLS.
DOMAIN=nutrition-label-generator.example.com

# Backend overrides (any field in backend/app/config.py is overridable via env).
# Leave CORS_ORIGINS empty in production — the SPA is same-origin via Caddy.
CORS_ORIGINS=[]

# Hostnames the app responds to. Anything else → 400. Replace the example
# domain below with your real one before deploying.
ALLOWED_HOSTS=["nutrition-label-generator.org","localhost","127.0.0.1"]

# Python log level for the backend (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Tune if you see 429s legitimately or want stricter limits.
RATE_LIMIT_SEARCH=60/minute
RATE_LIMIT_FOOD=120/minute

# Bumped/written by your release pipeline; surfaced at /api/health.
RELEASE_SHA=dev
