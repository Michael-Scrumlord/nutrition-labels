# Frontend build-time configuration.
# Copy to .env.local for local dev, or set in your CI/host env for prod builds.
# Vite inlines VITE_* values into the JS bundle at build time.

# Buy Me a Coffee (or Ko-fi, GitHub Sponsors, etc.) profile URL.
# Leave unset to hide the Donate button entirely.
VITE_DONATE_URL=https://buymeacoffee.com/

# Optional: change the button label. Defaults to "DONATE".
# VITE_DONATE_LABEL=BUY ME A COFFEE

# Contact email shown in the site footer (default: inquiries@nutrition-label-generator.org).
# VITE_CONTACT_EMAIL=hello@your-domain.example

# ── Google AdSense ────────────────────────────────────────────────────────
# Until BOTH of these are set with real values, AdSense + Funding Choices
# (CMP) are not loaded. See src/config/adsense.ts.
#
# Get the publisher ID from AdSense after approval (starts with "ca-pub-"):
# VITE_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
#
# Slot ID for the sidebar 300×250 rectangle, created in
# AdSense → Ads → By ad unit → Display ad:
# VITE_ADSENSE_SIDEBAR_SLOT=XXXXXXXXXX
#
# Set to "1" to load AdSense + CMP in `vite dev` too (off by default —
# dev traffic to AdSense is reported as invalid).
# VITE_ADSENSE_LOAD_IN_DEV=1
