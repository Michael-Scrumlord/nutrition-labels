## Signature Map — Frontend  (`frontend/src/utils/`)

### `units.ts`
```typescript
UNIT_CONVERSIONS: Record<UnitKey, number>      // identical to backend

convertToGrams(amount: number, unit: UnitKey): number
  // amount * UNIT_CONVERSIONS[unit]

convertBetweenUnits(amount: number, from: UnitKey, to: UnitKey): number
  // No-op when from === to; otherwise to-grams-then-to-target; preserves weight

normalizePortion(p: PortionSize): PortionRef
  // { modifier, gramsPerUnit: p.gram_weight / p.amount }

ingredientGrams(item: Pick<IngredientItem,"amount"|"unit"|"portionRef">): number
  // portionRef ? amount * portionRef.gramsPerUnit : amount * UNIT_CONVERSIONS[unit]
  // Single source of truth for ingredient weight
```

### `nutrition.ts`  (label math + FDA-compliant formatting)
```typescript
FDA_DAILY_VALUES: Partial<Record<keyof MacroProfile, number>>
ADDED_SUGARS_DV = 50           // g — not in FDA_DAILY_VALUES because not a MacroProfile key
NUTRIENT_FIELDS: (keyof MacroProfile)[]

roundHalfUp(x: number, ndigits?: number): number   // Number(x.toFixed(n)); matches Python Decimal
round1(n: number): number                          // = roundHalfUp(n, 1)

calculateRecipeMacros(ingredients: IngredientItem[], portionDivisor: number): MacroProfile
  // Uses ingredient.baseMacros (per-100g) + ingredientGrams() for weight
  // Throws RangeError if portionDivisor ∉ [1,999]
  // Returns UNROUNDED MacroProfile — presentation layer rounds via formatNutrientAmount

computeDailyValues(profile: MacroProfile): Partial<Record<keyof MacroProfile, number>>
  // {nutrient: roundHalfUp((val / DV) * 100)} for nutrients with DV

getHighlightKeys(baseMacros: MacroProfile): HighlightSet
  // Top-2 nutrient keys by (baseMacros[k] / DV) ratio — drives hover-sync highlight

formatNutrientAmount(nutrient: keyof MacroProfile, value: number): string
  // FDA 21 CFR 101.9(c) increment rounding, returns FULL display token with unit:
  //   calories:   <5 → "0";  ≤50 → nearest 5;  else nearest 10  (no unit)
  //   fat:        <0.5 → "0g";  <5 → 0.5g steps;  else 1g steps
  //   cholesterol:<2 → "0mg";  2–5 → "less than 5mg";  else 5mg steps
  //   sodium:     <5 → "0mg";  ≤140 → 5mg;  else 10mg
  //   carbs/fiber/sugar/protein: <0.5 → "0g";  <1 → "less than 1g";  else 1g
  //   vitamin_d:  0.1mcg steps    iron: 0.1mg    calcium/potassium: 10mg

formatAddedSugarsAmount(value: number): string      // same rules as sugar_g
formatTransFatAmount(value: number): string         // same rules as fat_total_g
formatDVFromAmount(amount: number, dv: number, isMicro?: boolean): string
  // "<1%" if pct rounds to 0 but amount > 0; else "{n}%"
  // isMicro=true → coarser rounding: ≤10% → 2s, ≤50% → 5s, else 10s
formatDV(nutrient: keyof MacroProfile, profile: MacroProfile): string
  // "—" if no DV; else delegates to formatDVFromAmount (micronutrients auto-detected)

buildIngredientsString(ingredients: IngredientItem[]): string
  // Sorted by ingredientGrams() desc, ALL CAPS, comma-separated, period-terminated; "" if empty
```

