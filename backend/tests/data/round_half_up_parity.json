{
  "_comment": "Shared parity vectors for the round-half-up helper. Both backend/app/nutrition.py:round_half_up and frontend/src/utils/nutrition.ts:roundHalfUp must produce these outputs for these inputs. The .x5 boundary values (0.15, 0.35, 1.45, 2.55) are the ones a naive Math.round(x*f + EPSILON) gets wrong. See issue #21 (H-1).",
  "cases": [
    {"input": 0.0,    "ndigits": 1, "expected": 0.0},
    {"input": 0.04,   "ndigits": 1, "expected": 0.0},
    {"input": 0.05,   "ndigits": 1, "expected": 0.1},
    {"input": 0.15,   "ndigits": 1, "expected": 0.1},
    {"input": 0.25,   "ndigits": 1, "expected": 0.3},
    {"input": 0.35,   "ndigits": 1, "expected": 0.3},
    {"input": 0.45,   "ndigits": 1, "expected": 0.5},
    {"input": 1.25,   "ndigits": 1, "expected": 1.3},
    {"input": 1.45,   "ndigits": 1, "expected": 1.4},
    {"input": 2.55,   "ndigits": 1, "expected": 2.5},
    {"input": 3.7,    "ndigits": 1, "expected": 3.7},
    {"input": 1234.56789, "ndigits": 1, "expected": 1234.6},
    {"input": 0.5,    "ndigits": 0, "expected": 1.0},
    {"input": 2.5,    "ndigits": 0, "expected": 3.0},
    {"input": 3.5,    "ndigits": 0, "expected": 4.0},
    {"input": 4.5,    "ndigits": 0, "expected": 5.0},
    {"input": 14.5,   "ndigits": 0, "expected": 15.0},
    {"input": 100.5,  "ndigits": 0, "expected": 101.0}
  ]
}
