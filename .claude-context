referencedVariableNames(text: string, variables: RecipeVariable[]): Set<string>
  // Slugified names of all variables actually referenced in text

insertVariableAt(text: string, cursor: number, variable: RecipeVariable):
  { text: string; cursorAfter: number }
  // Inserts "{variable.label}"; adds surrounding spaces as needed
