# Caddyfile — production edge.
#
# Caddy handles TLS termination (auto Let's Encrypt), HSTS, gzip, and proxies
# everything to the internal `frontend` container which serves the SPA and
# proxies /api/ to the backend.
#
# Set DOMAIN in your .env (e.g. DOMAIN=nutrition-label-generator.example.com).
# For local testing, swap {$DOMAIN} for `:80` and remove the tls block.

# The rate_limit directive is provided by github.com/mholt/caddy-ratelimit,
# baked into the local Caddy build (see caddy/Dockerfile). It MUST be declared
# at the global level before site blocks reference it.
#
# NOTE: PDF generation moved entirely client-side (@react-pdf/renderer) and
# POST /api/generate_label was removed from the backend, so there is
# currently no edge-level rate_limit zone below — the route it used to
# protect no longer exists. All remaining routes (/api/search, /api/food/*)
# are unrestricted at the edge; slowapi inside FastAPI still rate-limits
# them (60/min, 120/min respectively). If a new expensive endpoint is added,
# reintroduce a `rate_limit { zone ... }` block here scoped to its path.
{
    order rate_limit before reverse_proxy
}

{$DOMAIN} {
    encode zstd gzip

    # TLS via Cloudflare Origin Certificate (mounted read-only into the
    # container at /etc/caddy/certs by docker-compose.yml). The cert is only
    # trusted by Cloudflare's edge — direct browser connections will reject
    # it, which is the point: clients should always reach us via the
    # Cloudflare proxy. SSL/TLS mode at Cloudflare must be Full (strict).
    # If you ever need to roll back to public Let's Encrypt, comment out
    # this line and Caddy will resume auto-ACME using TLS-ALPN/HTTP-01.
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

    # HSTS — only enable once you're certain TLS works for your apex + www.
    # 1 year, include subdomains, eligible for preload.
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    header -Server

    reverse_proxy frontend:80 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
    }
}
