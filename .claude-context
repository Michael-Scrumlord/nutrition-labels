## Label rendering — `components/label/labelSpec.ts` (SHARED)

Both `LabelPreview.tsx` (DOM) and `LabelPdfDoc.tsx` (@react-pdf/renderer) import from
here so they can never disagree on a value, its rounding, its %DV, or the row order.
```typescript
INK = "#000"                       // regulated: black on white
GEO: { pagePadding, labelName, box, title, servings, servingSize, amountLabel,
       calories, dvHeader, row, proteinRule, footnote, ingredients, indent }
  // All dimensions in POINTS (PDF native unit). Preview renders them 1:1 as px
  // at authoring width — layouts are uniform scales of each other.

LabelRow { label, nutrient?, source?: "macro"|"transFat"|"addedSugars",
           bold, indent: 0|1|2, noDV? }
MACRO_ROWS: readonly LabelRow[]    // Total Fat → Added Sugars
MICRO_ROWS: readonly LabelRow[]    // Vitamin D / Calcium / Iron / Potassium

rowDisplay(row, macros, transFatG, addedSugarsG): RowDisplay
  // { label, amount, boldLabel, dv } — canonical strings for a row
  // "transFat" → { label:"Trans Fat", amount: formatTransFatAmount(transFatG), dv: null }
  // "addedSugars" → { label:"Includes {n}g Added Sugars", dv: formatDVFromAmount(addedSugarsG, 50) }
```

