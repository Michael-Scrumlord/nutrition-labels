### nutrition.py
```python
round_half_up(x: float, ndigits: int=0) → float
  # Decimal(x).quantize(Decimal(10**-ndigits), rounding=ROUND_HALF_UP)

calculate_recipe_macros(
    ingredients: list[IngredientItem],
    food_rows: list,          # sqlite3.Row objects from get_foods_by_ids()
    portion_divisor: int
) → tuple[dict[str, float], MacroProfile]
  # Returns (unrounded_per_serving, rounded_MacroProfile)
  # Per ingredient: grams = amount * UNIT_CONVERSIONS[unit]
  #                 total[f] += food[f] * (grams / 100)
  # Per serving:    val = total[f] / portion_divisor
  # Rounding:       calories → int, others → round_half_up(val, 1)
  # Raises ValueError: portion_divisor ≤ 0, or fdc_id not in food_rows

compute_daily_value_pct(value: float, nutrient: str) → int | None
  # None if nutrient not in FDA_DAILY_VALUES
  # else int(round_half_up((value / DV) * 100, 0))
  # Caller renders "<1%" when result==0 but value>0
```

