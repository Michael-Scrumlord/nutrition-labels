  // numeric form; label display goes through formatDV/formatDVFromAmount instead

formatNutrientAmount(nutrient: keyof MacroProfile, value: number): string
  // FDA 21 CFR 101.9(c) increment rounding, returns the full display token
  // incl. unit ("8g", "less than 1g", "160mg", "<1%" is NOT here — see formatDV).
  // Each nutrient has its own increment/floor (e.g. sodium: <5→"0mg", ≤140→
  // nearest 5mg, >140→nearest 10mg; calories: <5→"0", ≤50→nearest 5, else nearest 10).

formatTransFatAmount(value: number): string    // same increments as fat_total_g
formatAddedSugarsAmount(value: number): string // same increments as sugar_g

formatDVFromAmount(amount: number, dv: number, isMicro?: boolean): string
  // "<1%" if rounds to 0 but amount > 0, else "{n}%". isMicro=true uses
  // coarser FDA micronutrient %DV increments (2 below 10%, 5 to 50%, 10 above).

formatDV(nutrient: keyof MacroProfile, profile: MacroProfile): string
  // "—" if no DV, else defers to formatDVFromAmount (isMicro for vitamin_d/calcium/iron/potassium)

getHighlightKeys(baseMacros: MacroProfile): HighlightSet
  // Top-2 nutrient keys by (baseMacros[k] / DV) ratio — drives hover-sync highlight

buildIngredientsString(ingredients: IngredientItem[]): string
  // Sorted by ingredientGrams() desc, ALL CAPS, comma-separated, period-terminated; "" if empty
