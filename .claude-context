type StepToken =
  | { kind: "text";    content: string }
  | { kind: "var";     variable: RecipeVariable; raw: string }
  | { kind: "missing"; label: string; raw: string }

slugify(label: string): string
  // lowercase, [^a-z0-9]+ -> "_", trim leading/trailing "_"; "" fallback -> "var"

findVariable(variables: RecipeVariable[], key: string): RecipeVariable | undefined
  // Matches by variable.name (slug) OR variable.label (case-insensitive)

