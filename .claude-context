## FRONTEND SIGNATURE MAP — frontend/src/

### types/index.ts (key types)
  UnitKey: "g" | "ml" | "oz" | "lb" | "kg"
  UNIT_LABELS: Record<UnitKey, string>  # display labels
  MacroProfile: { calories, fat_total_g, ...13 nutrients... }  # all number
  IngredientItem: { fdc_id, name, amount, unit: UnitKey, baseMacros: MacroProfile }
  FoodSearchResult: { fdc_id: number, name: string }
  PortionSize: { amount, modifier, gram_weight }
  FoodDetail: { fdc_id, name, macros: MacroProfile, portions: PortionSize[] }
  SavedFood: { fdc_id: number, name: string }
  LabelDimensions: { widthInches: number, heightInches: number | null }
  HighlightSet: Set<keyof MacroProfile>  # shared across recipe builder + label for hover-sync
  RecipeStep: { id: string, text: string }  # text contains {Variable Label} tokens
  RecipeVariable: { name: string, label: string, value: number, suffix?, min?, max?, step? }
  RecipeVersion: { id, savedAt, note?, ingredients, portionDivisor, labelName, dimensions, instructions, variables }
  SavedRecipe: { id, name, createdAt, versions: RecipeVersion[] }  # versions.at(-1) = latest

### api/client.ts
  class ApiError extends Error { status: number; retryAfter?: number }
  searchFoods(query: string) → Promise<FoodSearchResult[]>
  getFoodDetail(fdc_id: number) → Promise<FoodDetail>
  generateLabel(ingredients, portionDivisor, labelName, dimensions) → Promise<Blob>
    # Strips baseMacros before POST; handles 429 → ApiError with retryAfter
  downloadBlob(blob: Blob, filename: string) → void

### store/recipeStore.ts (Zustand, not persisted)
  state: { ingredients[], portionDivisor=8, labelName="", dimensions={w:2.75,h:null},
           highlightedNutrients: HighlightSet, instructions: RecipeStep[], variables: RecipeVariable[],
           currentRecipeId: string|null, viewingVersionId: string|null }
  ingredient actions: addIngredient, removeIngredient, updateIngredientName,
                      updateIngredientAmount, updateIngredientUnit, moveIngredient
  meta actions: setPortionDivisor, setLabelName, setDimensions(Partial<>), setHighlightedNutrients
  method actions: addStep(afterId?)→id, updateStepText, removeStep, moveStep
                  addVariable (no-op if name exists), setVariableValue, updateVariable, removeVariable
  lifecycle: clearRecipe, loadRecipe(SavedRecipe), loadVersion(SavedRecipe, RecipeVersion),
             exitVersionView, setCurrentRecipeId

### store/preferencesStore.ts (Zustand + localStorage persist "nl_preferences")
  state: { recents: SavedFood[], favorites: SavedFood[] }
  actions: addRecent(food) [dedupe, prepend, trim to 15], toggleFavorite, isFavorite(id)→bool
  partialize: stores under keys "nl_recents" / "nl_favorites"

### store/savedRecipesStore.ts (Zustand + localStorage persist "nl_saved_recipes", version:2)
  type RecipeSnapshot = { ingredients, portionDivisor, labelName, dimensions, instructions, variables }
  state: { recipes: SavedRecipe[] }  # max 50 recipes
  actions: createRecipe(snapshot, note?)→id, appendVersion(recipeId, snapshot, note?) [trim to 20],
           renameRecipe(recipeId, name), deleteRecipe(recipeId), deleteVersion(recipeId, versionId)
  migration: v1→v2 wraps flat snapshot as single RecipeVersion

### store/themeStore.ts (Zustand + localStorage persist "nl-theme")
  ThemeKey: "paper" | "overcast" | "twilight" | "midnight"
  THEME_DEFS: Record<ThemeKey, ThemeDef>  # bg/surface/ink/hairline/accent CSS vars; oled flag
  THEME_ORDER: ThemeKey[]
  useThemeStore: { theme, accents: Record<ThemeKey,string>, setTheme, setAccent }
  useActiveTheme() → { theme, def: ThemeDef, accent: AccentDef }
  themeVars(def, accentHex) → Record<string,string>  # CSS var map (--bg, --ink, --accent, etc.)

### hooks/
  useNutritionCalc() → MacroProfile  # useMemo over calculateRecipeMacros
  useIngredientSearch(query) → { results, isLoading, isError }  # 300ms debounce, staleTime 30s
  useLabelResize() → { onMouseDown }  # drag resize; 96px/in; clamp [200,600]px → [2.08,6.25]in
  useAnimatedNumber(target, duration=420) → number  # cubic-ease-out rAF loop; returns Math.round
  useRecipeActions() → all store actions  # useShallow to prevent re-renders on stable refs

